# Backend API configuration. Copy to apps/api/.env (or the repo root .env)
# for local development. All values have safe defaults via zod validation.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Upper bound (MB) for accepted request bodies. Generous for stress-test
# payloads, but bounded so bad inputs cannot exhaust memory.
MAX_BODY_MB=20
# Express `trust proxy` setting. "loopback" is safe locally; use the actual
# reverse-proxy value (e.g. "1" or a CIDR) when deployed behind a proxy.
TRUST_PROXY=loopback

# --- Benchmark engine guards ---
# Hard timeout (ms) for regex execution. A worker running a pathological
# (catastrophic backtracking) pattern is terminated when this expires.
REGEX_TIMEOUT_MS=5000
# Upper bound on benchmark iterations per request.
BENCH_MAX_ITERATIONS=100
# Upper bound (chars) on the regex_match source text buffer.
BENCH_MAX_TEXT_CHARS=16777216
