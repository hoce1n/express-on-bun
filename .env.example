# ---------------------------------------------------------------------------
# Root environment template. Copy to `.env` for local development.
# Both services read their relevant subset from the same process environment.
# ---------------------------------------------------------------------------

# --- Backend API (apps/api) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Upper bound (in MB) for request bodies accepted by the API. Stress-test
# payloads can be large, but this keeps the server bounded.
MAX_BODY_MB=20
# Express `trust proxy` setting. Use "loopback" in local dev, or the
# reverse-proxy hop count / subnet in production behind a load balancer.
TRUST_PROXY=loopback

# --- Dashboard (apps/dashboard) ---
# Base URL the browser uses for API calls. Keep "/api" in local dev so the
# Vite proxy forwards to the backend. In production set the deployed API URL.
VITE_API_BASE_URL=/api
